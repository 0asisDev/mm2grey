    end)
    pcall(function()
        if LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui") then
            table.insert(searchRoots, LocalPlayer:FindFirstChildOfClass("PlayerGui"))
        end
    end)

    local function HookJumpModifier(label)
        local row = label.Parent
        if not row or row:FindFirstChild("InfJumpToggle") then return end

        -- Création du switch toggle Pill shape (style officiel Zero Point)
        local toggleBg = Instance.new("TextButton")
        toggleBg.Name = "InfJumpToggle"
        toggleBg.Size = UDim2.new(0, 38, 0, 18)
        toggleBg.Position = UDim2.new(1, -44, 0.5, -9)
        toggleBg.BackgroundColor3 = MM2State.InfJump and Color3.fromRGB(220, 20, 100) or Color3.fromRGB(30, 25, 35)
        toggleBg.BorderSizePixel = 0
        toggleBg.Text = ""
        toggleBg.AutoButtonColor = false
        toggleBg.ZIndex = (label.ZIndex or 1) + 10
        toggleBg.Parent = row
        Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = Color3.fromRGB(60, 45, 70)
        stroke.Parent = toggleBg

        local knob = Instance.new("Frame")
        knob.Name = "Knob"
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = MM2State.InfJump and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.ZIndex = toggleBg.ZIndex + 1
        knob.Parent = toggleBg
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local function SetToggleState(val)
            _G.InfJump = val
            MM2State.InfJump = val
            TweenService:Create(toggleBg, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                BackgroundColor3 = val and Color3.fromRGB(220, 20, 100) or Color3.fromRGB(30, 25, 35)
            }):Play()
            TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                Position = val and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            }):Play()
        end

        toggleBg.MouseButton1Click:Connect(function()
            SetToggleState(not _G.InfJump)
        end)

        if label:IsA("TextButton") then
            label.MouseButton1Click:Connect(function()
                SetToggleState(not _G.InfJump)
            end)
        end

        -- Synchronisation globale si l'état change via une autre commande/UI
        task.spawn(function()
            local lastState = MM2State.InfJump
            while toggleBg and toggleBg.Parent do
                if MM2State.InfJump ~= lastState then
                    lastState = MM2State.InfJump
                    SetToggleState(lastState)
                end
                task.wait(0.2)
            end
        end)
    end

    local function CheckDescendant(desc)
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) then
            local clean = desc.Text:lower():gsub("%s+", "")
            if clean == "jumpmodifier" or desc.Text:lower():find("jump modifier") then
                HookJumpModifier(desc)
            end
        end
    end

    -- 1. Scan initial
    for _, root in ipairs(searchRoots) do
        for _, desc in ipairs(root:GetDescendants()) do
            CheckDescendant(desc)
        end
    end

    -- 2. Écoute événementielle dès qu'un nouvel élément apparaît (ex: chargement de Zero Point)
    for _, root in ipairs(searchRoots) do
        root.DescendantAdded:Connect(function(desc)
            task.wait(0.05)
            CheckDescendant(desc)
        end)
    end

    -- 3. Surveillance continue en tâche de fond (toutes les 1.5s)
    task.spawn(function()
        while task.wait(1.5) do
            for _, root in ipairs(searchRoots) do
                for _, desc in ipairs(root:GetDescendants()) do
                    CheckDescendant(desc)
                end
            end
        end
    end)
end

