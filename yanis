local function FlingPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LP then return end
    local character, targetChar = LP.Character, targetPlayer.Character
    if not character or not targetChar then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid or not targetRoot then return end

    local previousCFrame = root.CFrame

    local noClipConn = RunService.Stepped:Connect(function()
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)

    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "FlingVelocity"
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
    bav.Parent = root

    local startTime, timeout = tick(), 1.6
    local flingConn
    flingConn = RunService.Heartbeat:Connect(function()
        if tick() - startTime >= timeout or not targetRoot or not targetRoot.Parent then
            flingConn:Disconnect()
            noClipConn:Disconnect()
            bav:Destroy()
            root.Velocity = Vector3.new(0, 0, 0)
            root.RotVelocity = Vector3.new(0, 0, 0)
            root.CFrame = previousCFrame
            return
        end
        local vel = targetRoot.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
        root.CFrame = CFrame.new(targetRoot.Position + (vel * 0.12))
    end)
end

