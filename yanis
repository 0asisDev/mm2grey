-- Metamethod Hook sécurisé Mouse.Hit / Mouse.Target
pcall(function()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    setreadonly(mt, false)

    mt.__index = newcclosure(function(self, prop)
        if not checkcaller() and typeof(self) == "Instance" and self:IsA("Mouse") then
            local char = LocalPlayer.Character
            if char then
                if MM2State.SheriffSilentAim and char:FindFirstChild("Gun") then
                    local target = GetMurderer()
                    if target and target.Character then
                        local tPart = target.Character:FindFirstChild(MM2State.TargetPart) or target.Character:FindFirstChild("HumanoidRootPart")
                        if tPart then
                            local predicted = tPart.Position
                            if MM2State.PredictMovement and tPart.AssemblyLinearVelocity then
                                predicted = predicted + (tPart.AssemblyLinearVelocity * 0.05)
                            end
                            if prop == "Hit" then return CFrame.new(predicted) end
                            if prop == "Target" then return tPart end
                        end
                    end
                end

                if MM2State.MurderSilentAim and char:FindFirstChild("Knife") then
                    local target = GetClosestTargetForMurder()
                    if target and target.Character then
                        local tPart = target.Character:FindFirstChild(MM2State.TargetPart) or target.Character:FindFirstChild("HumanoidRootPart")
                        if tPart then
                            local predicted = tPart.Position
                            if MM2State.PredictMovement and tPart.AssemblyLinearVelocity then
                                predicted = predicted + (tPart.AssemblyLinearVelocity * 0.05)
                            end
                            if prop == "Hit" then return CFrame.new(predicted) end
                            if prop == "Target" then return tPart end
                        end
                    end
                end
            end
        end
        return oldIndex(self, prop)
    end)

    setreadonly(mt, true)
end)

