local throwDebounce = false
local function ThrowKnifeSilent(customTarget)
    if throwDebounce then return end

    local char = LocalPlayer.Character
    if not char then return end

    local knife = char:FindFirstChild("Knife")
    if not knife then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp and bp:FindFirstChild("Knife") then
            bp.Knife.Parent = char
            knife = char:FindFirstChild("Knife")
            task.wait(0.04)
        end
    end
    if not knife then return end

    local target = customTarget or GetClosestTargetForMurder()
    if not target or not target.Character then return end
    local tRoot = target.Character:FindFirstChild(MM2State.TargetPart) or target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
    if not tRoot then return end

    throwDebounce = true

    local knifeRemote = nil
    local events = knife:FindFirstChild("Events")
    if events then
        knifeRemote = events:FindFirstChild("KnifeThrown")
    end
    if not knifeRemote then
        for _, desc in ipairs(knife:GetDescendants()) do
            if desc:IsA("RemoteEvent") and (desc.Name:lower():find("throw") or desc.Name:lower():find("knife")) then
                knifeRemote = desc
                break
            end
        end
    end

    local handle = knife:FindFirstChild("Handle") or knife:FindFirstChildWhichIsA("BasePart") or (char:FindFirstChild("HumanoidRootPart"))
    local predictedPos = tRoot.Position
    if MM2State.PredictMovement and tRoot.AssemblyLinearVelocity then
        predictedPos = predictedPos + (tRoot.AssemblyLinearVelocity * 0.05)
    end

    if knifeRemote and handle then
        pcall(function()
            knifeRemote:FireServer(handle.CFrame, predictedPos)
        end)
    end

    pcall(function()
        knife:Activate()
    end)

    task.delay(0.28, function()
        throwDebounce = false
    end)
end

local shootDebounce = false
local function ShootGunSilent(customTarget)
    if shootDebounce then return end

    local char = LocalPlayer.Character
    if not char then return end

    local gun = char:FindFirstChild("Gun")
    if not gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp and bp:FindFirstChild("Gun") then
            bp.Gun.Parent = char
            gun = char:FindFirstChild("Gun")
            task.wait(0.04)
        end
    end
    if not gun then return end

    local target = customTarget or GetMurderer()
    if not target or not target.Character then return end
    local tRoot = target.Character:FindFirstChild(MM2State.TargetPart) or target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
    if not tRoot then return end

    shootDebounce = true

    local shootRemote = nil
    local events = gun:FindFirstChild("Events") or gun:FindFirstChild("GunClient")
    if events then
        shootRemote = events:FindFirstChild("Shoot") or events:FindFirstChild("ShootGun")
    end
    if not shootRemote then
        for _, desc in ipairs(gun:GetDescendants()) do
            if desc:IsA("RemoteEvent") and desc.Name:lower():find("shoot") then
                shootRemote = desc
                break
            end
        end
    end

    local predictedPos = tRoot.Position
    if MM2State.PredictMovement and tRoot.AssemblyLinearVelocity then
        predictedPos = predictedPos + (tRoot.AssemblyLinearVelocity * 0.05)
    end

    if shootRemote then
        pcall(function()
            shootRemote:FireServer(predictedPos)
        end)
    end

    pcall(function()
        gun:Activate()
    end)

    task.delay(0.28, function()
        shootDebounce = false
    end)
end

