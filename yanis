local function TeleportToActiveMap()
    -- 1. Coins de la map
    local coinContainer = Workspace:FindFirstChild("CoinContainer") or Workspace:FindFirstChild("Coins")
    if coinContainer then
        local coin = coinContainer:FindFirstChildWhichIsA("BasePart") or coinContainer:FindFirstChild("Coin_Server")
        if coin and coin:IsA("BasePart") then
            TeleportTo(coin.CFrame + Vector3.new(0, 3, 0))
            return true
        end
    end

    -- 2. Modèle de la map active (Y < 350)
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name ~= "RegularLobby" and obj.Name ~= "Lobby" and not Players:GetPlayerFromCharacter(obj) then
            local spawns = obj:FindFirstChild("Spawns") or obj:FindFirstChild("Spawn")
            if spawns then
                local p = spawns:FindFirstChildWhichIsA("BasePart") or spawns
                if p:IsA("BasePart") and p.Position.Y < 350 then
                    TeleportTo(p.CFrame + Vector3.new(0, 3, 0))
                    return true
                end
            end
            for _, part in ipairs(obj:GetChildren()) do
                if part:IsA("BasePart") and part.Position.Y < 300 and part.Size.Magnitude > 10 then
                    TeleportTo(part.CFrame + Vector3.new(0, 4, 0))
                    return true
                end
            end
        end
    end

    -- 3. Joueur actuellement en match
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsPlayerInGame(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            TeleportTo(p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 2, 0))
            return true
        end
    end
    return false
end

