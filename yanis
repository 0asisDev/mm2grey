    if not name then return 0 end
    local clean = name:lower():gsub("[^%a%s%d]", ""):gsub("^%s*(.-)%s*$", "%1")
    for k, v in pairs(ItemValues) do
        if clean:find(k, 1, true) then
            return v
        end
    end
    return 10
