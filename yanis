local function IsKnife(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = tool.Name:lower()
    if name == "knife" then return true end
    if tool:FindFirstChild("KnifeLocal") or tool:FindFirstChild("KnifeServer") then return true end
    for k in pairs(KnownKnives) do
        if name:find(k, 1, true) then return true end
    end
    for _, child in ipairs(tool:GetChildren()) do
        if child.Name:lower():find("knife") or child.Name:lower():find("slash") then return true end
    end
    return false
end

local function IsGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = tool.Name:lower()
    if name == "gun" or name == "revolver" then return true end
    if tool:FindFirstChild("GunLocal") or tool:FindFirstChild("GunScript") then return true end
    for k in pairs(KnownGuns) do
        if name:find(k, 1, true) then return true end
    end
    for _, child in ipairs(tool:GetChildren()) do
        if child.Name:lower():find("gun") or child.Name:lower():find("shoot") then return true end
    end
    return false
end

local function GetPlayerRoleFast(player)
    if not player then return "Innocent" end
    local bp = player:FindFirstChild("Backpack")
    local ch = player.Character

    -- Vérification Murderer
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if IsKnife(t) then return "Murderer" end
        end
    end
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if IsKnife(t) then return "Murderer" end
        end
    end

    -- Vérification Sheriff
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if IsGun(t) then return "Sheriff" end
        end
    end
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if IsGun(t) then return "Sheriff" end
        end
    end

    return "Innocent"
end

local function GetMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRoleFast(p) == "Murderer" then
            return p
        end
    end
    return nil
end

local function GetSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and GetPlayerRoleFast(p) == "Sheriff" then
            return p
        end
    end
    return nil
end

local function GetClosestTargetForMurder()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local closest, minDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
            if tRoot and tHum and tHum.Health > 0 and IsPlayerInGame(p) then
                local dist = (myHrp.Position - tRoot.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

-- -------------------------------------------------------------------------
-- 🎯 SILENT AIM HOOK (AVEC DIRECTIVE TOGGLE AIMBOT ET SÉCURITÉ METAMETHOD)
-- -------------------------------------------------------------------------
local hookmetamethod = hookmetamethod
local checkcaller = checkcaller or function() return false end

if hookmetamethod then
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        -- Règle absolue de sécurité metamethod : toujours vérifier typeof(self) == "Instance"
        if not checkcaller() and typeof(self) == "Instance" and self:IsA("Mouse") then
            -- Protection totale du trade : ne jamais altérer Mouse lors d'un échange
            local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            local tradeGui = pGui and pGui:FindFirstChild("TradeGUI")
            if tradeGui and tradeGui.Enabled then
                return oldIndex(self, key)
            end

            if (key == "Hit" or key == "Target") and State.AimbotEnabled then
                local char = LocalPlayer.Character
                if char then
                    local holdingGun = false
                    local holdingKnife = false
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        holdingGun = IsGun(tool)
                        holdingKnife = IsKnife(tool)
                    end

                    local target = nil

                    -- 1. Mode Sheriff : Cible le Murderer
                    if holdingGun and State.SilentAimSheriff then
                        target = GetMurderer()

                    -- 2. Mode Murderer : Cible le joueur choisi ou le plus proche
                    elseif holdingKnife and State.SilentAimMurder then
                        target = State.TargetPlayer or GetClosestTargetForMurder()
                    end

                    if target and target.Character and IsPlayerInGame(target) then
                        local part = target.Character:FindFirstChild(State.TargetPart) or target.Character:FindFirstChild("HumanoidRootPart")
                        if part then
                            local finalPos = part.Position

                            -- Prédiction adaptative de trajectoire selon la vélocité et la distance
                            if State.PredictMovement and (part.AssemblyLinearVelocity or part.Velocity) then
                                local myHrp = char:FindFirstChild("HumanoidRootPart")
                                local myPos = myHrp and myHrp.Position or char:GetPivot().Position
                                local dist = (myPos - part.Position).Magnitude
                                local projectileSpeed = holdingGun and 300 or 150
                                local leadTime = math.clamp(dist / projectileSpeed, 0.02, 0.45)
                                local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
                                finalPos = finalPos + (vel * leadTime)
                            end

                            if key == "Hit" then
                                return CFrame.new(finalPos)
                            elseif key == "Target" then
                                return part
                            end
                        end
                    end
                end
            end
        end
        return oldIndex(self, key)
    end))
end

-- -------------------------------------------------------------------------
-- 🔪 HOOK NAMECALL SILENT AIM (LANCER DE COUTEAU GARANTI SUR KNIFETHROWN)
-- -------------------------------------------------------------------------
if hookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        -- Règle absolue de sécurité metamethod : toujours vérifier typeof(self) == "Instance"
        if not checkcaller() and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
            local method = getnamecallmethod()
            if method == "FireServer" and State.AimbotEnabled and State.SilentAimMurder then
                local remoteName = self.Name:lower()
                if remoteName == "knifethrown" or remoteName:find("throw") then
                    local target = State.TargetPlayer or GetClosestTargetForMurder()
                    if target and target.Character and IsPlayerInGame(target) then
                        local tPart = target.Character:FindFirstChild(State.TargetPart)
                            or target.Character:FindFirstChild("HumanoidRootPart")
                            or target.Character:FindFirstChild("Head")
                        if tPart then
                            local finalPos = tPart.Position
                            if State.PredictMovement and (tPart.AssemblyLinearVelocity or tPart.Velocity) then
                                local vel = tPart.AssemblyLinearVelocity or tPart.Velocity or Vector3.zero
                                local myChar = LocalPlayer.Character
                                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                                local myPos = myHrp and myHrp.Position or (myChar and myChar:GetPivot().Position) or Vector3.zero
                                local dist = (myPos - tPart.Position).Magnitude
                                local leadTime = math.clamp(dist / 160, 0.02, 0.45)
                                finalPos = finalPos + (vel * leadTime)
                            end

                            local args = {...}
                            -- Dans MM2 KnifeThrown : args[1] = handle CFrame, args[2] = Vector3 position cible
                            if #args >= 2 then
                                args[2] = finalPos
                                return oldNamecall(self, unpack(args))
                            elseif #args == 1 then
                                if typeof(args[1]) == "Vector3" then
                                    args[1] = finalPos
                                    return oldNamecall(self, unpack(args))
                                elseif typeof(args[1]) == "CFrame" then
                                    args[1] = CFrame.new(finalPos)
                                    return oldNamecall(self, unpack(args))
                                end
                            end
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end))
end

