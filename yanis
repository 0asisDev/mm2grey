-- Indexation des clés par ordre de longueur décroissante (les noms spécifiques avant les génériques)
local SortedValueKeys = {}
for k in pairs(ItemValues) do
    table.insert(SortedValueKeys, k)
end
table.sort(SortedValueKeys, function(a, b)
    return #a > #b
end)

local function LookupItemValue(name)
    if not name or name == "" then return 0 end
    local clean = name:lower():gsub("[^%a%s%d]", ""):gsub("%s+", " "):gsub("^%s*(.-)%s*$", "%1")
    if clean == "" then return 0 end

    -- 1. Correspondance exacte ultra-rapide O(1)
    if ItemValues[clean] then
        return ItemValues[clean]
    end

    -- 2. Recherche par sous-chaîne du plus spécifique au plus générique (ex: "Chroma Laser" avant "Laser")
    for _, k in ipairs(SortedValueKeys) do
        if #k >= 3 and clean:find(k, 1, true) then
            return ItemValues[k]
        end
    end

    return 0
end
