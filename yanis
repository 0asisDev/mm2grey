local function EquipKnife()
    local char = LocalPlayer.Character
    if not char then return nil end
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and IsKnife(equipped) then return equipped end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if IsKnife(t) then
                t.Parent = char
                return t
            end
        end
    end
    return nil
end

local function EquipGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and IsGun(equipped) then return equipped end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if IsGun(t) then
                t.Parent = char
                return t
            end
        end
    end
    return nil
end

local function Equip(name)
    local c = LP.Character
    if not c then return end
    local tool = c:FindFirstChild(name)
    if not tool then
        local bp = LP:FindFirstChild("Backpack")
        if bp and bp:FindFirstChild(name) then
            bp[name].Parent = c
            task.wait(0.04)
            tool = c:FindFirstChild(name)
        end
    end
    if not tool then
        if name == "Gun" then
            tool = EquipGun()
        elseif name == "Knife" then
            tool = EquipKnife()
        end
    end
    return tool
end

