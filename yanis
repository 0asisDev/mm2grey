    -- -----------------------------------------------
    -- LOGIQUE DE LANCEMENT LUAARMOR
    -- -----------------------------------------------
    local launched = false
    local function doLaunch()
        if launched then return end
        launched = true
        LaunchBtn.Text = "Chargement..."
        Status.Text    = "Chargement du script LuaArmor..."
        TweenService:Create(LaunchBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Theme.LaunchBtnHover
        }):Play()

        task.wait(0.4)
        ScreenGui:Destroy()

        if not GameData then
            warn("[Zero Point] Jeu non supporte. PlaceId=" .. tostring(game.PlaceId))
            return
        end

        -- Lancement direct du script officiel Zero Point protégé par LuaArmor
        local ok, err = pcall(function()
            loadstring(game:HttpGet(GameData.Loader))()
        end)
        if not ok then
            warn("[Zero Point] Erreur chargement : " .. tostring(err))
        end
    end

    LaunchBtn.MouseButton1Click:Connect(doLaunch)
    LaunchBtn.MouseEnter:Connect(function()
        TweenService:Create(LaunchBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Theme.LaunchBtnHover,
            TextColor3       = Color3.fromRGB(255, 255, 255),
        }):Play()
    end)
    LaunchBtn.MouseLeave:Connect(function()
        TweenService:Create(LaunchBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Theme.LaunchBtn,
            TextColor3       = Color3.fromRGB(15, 8, 20),
        }):Play()
    end)

