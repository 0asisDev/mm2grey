-- 💃 SYSTÈME DES PACKS D'ANIMATIONS & EMOTES
-- -------------------------------------------------------------------------
local function ApplyAnimationPack(packName)
    local char = LocalPlayer.Character
    if not char then return end
    local animScript = char:FindFirstChild("Animate")
    if not animScript then return end
    local pack = AnimationPacks[packName]
    if not pack then return end

    pcall(function()
        -- Walk
        local walkVal = animScript:FindFirstChild("walk")
        if walkVal and walkVal:FindFirstChildOfClass("Animation") then
            walkVal:FindFirstChildOfClass("Animation").AnimationId = pack.walk
        end
        -- Run
        local runVal = animScript:FindFirstChild("run")
        if runVal and runVal:FindFirstChildOfClass("Animation") then
            runVal:FindFirstChildOfClass("Animation").AnimationId = pack.run
        end
        -- Idle
        local idleVal = animScript:FindFirstChild("idle")
        if idleVal then
            local anims = idleVal:GetChildren()
            if anims[1] and pack.idle[1] then anims[1].AnimationId = pack.idle[1] end
            if anims[2] and (pack.idle[2] or pack.idle[1]) then anims[2].AnimationId = pack.idle[2] or pack.idle[1] end
        end
        -- Jump
        local jumpVal = animScript:FindFirstChild("jump")
        if jumpVal and jumpVal:FindFirstChildOfClass("Animation") then
            jumpVal:FindFirstChildOfClass("Animation").AnimationId = pack.jump
        end
        -- Fall
        local fallVal = animScript:FindFirstChild("fall")
        if fallVal and fallVal:FindFirstChildOfClass("Animation") then
            fallVal:FindFirstChildOfClass("Animation").AnimationId = pack.fall
        end
        -- Climb
        local climbVal = animScript:FindFirstChild("climb")
        if climbVal and climbVal:FindFirstChildOfClass("Animation") then
            climbVal:FindFirstChildOfClass("Animation").AnimationId = pack.climb
        end
    end)

    -- Réinitialiser les pistes en cours pour appliquer immédiatement le pack
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
            track:Stop()
        end
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
    State.ActivePack = packName
end

local function PlayEmoteById(assetId)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if State.CurrentTrack then
        State.CurrentTrack:Stop()
        State.CurrentTrack:Destroy()
        State.CurrentTrack = nil
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(assetId)
    local ok, track = pcall(function() return hum:LoadAnimation(anim) end)
    if ok and track then
        track:Play()
        State.CurrentTrack = track
    end
end

-- -------------------------------------------------------------------------
-- 🎵 UTILITAIRE AUDIO (EXTRACTEUR D'ID OU LIEN ROBLOX)
-- -------------------------------------------------------------------------
local function ExtractAudioId(input)
    if not input then return nil end
    local clean = input:gsub("^%s*(.-)%s*$", "%1")
    local pureNum = clean:match("^%d+$")
    if pureNum then return pureNum end

    local rbxId = clean:match("rbxassetid://(%d+)")
    if rbxId then return rbxId end

    local webId = clean:match("roblox%.com/library/(%d+)")
        or clean:match("roblox%.com/store/asset/(%d+)")
        or clean:match("asset/%?id=(%d+)")
        or clean:match("assetid=(%d+)")
    if webId then return webId end

    return clean:match("(%d+)")
end

