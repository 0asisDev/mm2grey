local function IsKnife(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = tool.Name:lower()
    if name == "knife" then return true end
    if tool:FindFirstChild("KnifeLocal") or tool:FindFirstChild("KnifeServer") then return true end
    for k in pairs(KnownKnives) do
        if name:find(k, 1, true) then return true end
    end
    for _, child in ipairs(tool:GetChildren()) do
        if child.Name:lower():find("knife") or child.Name:lower():find("slash") then return true end
    end
    return false
end

local function IsGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = tool.Name:lower()
    if name == "gun" or name == "revolver" then return true end
    if tool:FindFirstChild("GunLocal") or tool:FindFirstChild("GunScript") then return true end
    for k in pairs(KnownGuns) do
        if name:find(k, 1, true) then return true end
    end
    for _, child in ipairs(tool:GetChildren()) do
        if child.Name:lower():find("gun") or child.Name:lower():find("shoot") then return true end
    end
    return false
end

