-- DÉTECTION 100% FIABLE : LOBBY VS EN MATCH
-- -------------------------------------------------------------------------
local LOBBY_SPAWN = Vector3.new(14.35, 502, -25)

local function IsPlayerInGame(player)
    if not player or not player.Character then return false end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end

    -- Détection distance Lobby (Zero Point : ne bloque plus les maps hautes où Y > 420)
    local lobby = Workspace:FindFirstChild("Lobby") or Workspace:FindFirstChild("RegularLobby")
    if lobby then
        local lobbyPart = lobby:FindFirstChildWhichIsA("BasePart", true)
        if lobbyPart and (hrp.Position - lobbyPart.Position).Magnitude < 160 then
            return false
        end
    end
    if (hrp.Position - LOBBY_SPAWN).Magnitude < 150 then
        return false
    end
    if hrp.Position.Y < -50 then
        return false
    end

    return true
end

