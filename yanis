local function EquipKnife()
    local char = LocalPlayer.Character
    if not char then return nil end
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and IsKnife(equipped) then return equipped end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if IsKnife(t) then
                t.Parent = char
                return t
            end
        end
    end
    return nil
end

local throwDebounce = false

local function ThrowKnifeSilent(customTarget)
    if throwDebounce then return end

    local char = LocalPlayer.Character
    if not char then return end

    local knife = EquipKnife()
    if not knife then return end

    local target = customTarget or State.TargetPlayer or GetClosestTargetForMurder()
    if not target or not target.Character then return end

    local tPart = target.Character:FindFirstChild(State.TargetPart)
        or target.Character:FindFirstChild("HumanoidRootPart")
        or target.Character:FindFirstChild("Head")
    if not tPart then return end

    throwDebounce = true

    -- Recherche automatique du RemoteEvent officiel de lancer MM2
    local knifeRemote = nil
    local events = knife:FindFirstChild("Events")
    if events then
        knifeRemote = events:FindFirstChild("KnifeThrown") or events:FindFirstChild("Throw")
    end
    if not knifeRemote then
        knifeRemote = knife:FindFirstChild("KnifeThrown")
    end
    if not knifeRemote then
        for _, desc in ipairs(knife:GetDescendants()) do
            if desc:IsA("RemoteEvent") and (desc.Name:lower():find("throw") or desc.Name:lower():find("knife")) then
                knifeRemote = desc
                break
            end
        end
    end

    local handle = knife:FindFirstChild("Handle")
        or knife:FindFirstChildWhichIsA("BasePart")
        or char:FindFirstChild("RightHand")
        or char:FindFirstChild("HumanoidRootPart")

    -- Prédiction de trajectoire du lancer
    local finalPos = tPart.Position
    if State.PredictMovement and (tPart.AssemblyLinearVelocity or tPart.Velocity) then
        local vel = tPart.AssemblyLinearVelocity or tPart.Velocity or Vector3.zero
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        local myPos = myHrp and myHrp.Position or char:GetPivot().Position
        local dist = (myPos - tPart.Position).Magnitude
        local leadTime = math.clamp(dist / 160, 0.02, 0.45)
        finalPos = finalPos + (vel * leadTime)
    end

    -- 1. Appel du RemoteEvent de lancer officiel avec les bons arguments MM2
    if knifeRemote and handle then
        pcall(function()
            knifeRemote:FireServer(handle.CFrame, finalPos)
        end)
    end

    -- 2. Activation de l'animation / son natif de lancer
    pcall(function()
        knife:Activate()
    end)

    -- 3. Simulation de la touche E native pour garantir le lancer
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.04)
        vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)

    task.delay(0.3, function()
        throwDebounce = false
    end)
end

