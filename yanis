local function UpdateTradeGUI()
    if not State.TradeOverlay then
        TradeSummaryCard.Visible = false
        return
    end

    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pGui then return end

    local tradeGui = pGui:FindFirstChild("TradeGUI") or pGui:FindFirstChild("TradeGUI_Modern")
    if not tradeGui or not tradeGui.Enabled then
        TradeSummaryCard.Visible = false
        return
    end

    -- Hook auto accept (Zero Point exact)
    if State.AutoAcceptTrade then
        local acceptBtn = tradeGui:FindFirstChild("Accept", true)
        if acceptBtn and acceptBtn:IsA("GuiButton") and acceptBtn.Visible then
            pcall(function()
                if typeof(firesignal) == "function" then
                    firesignal(acceptBtn.MouseButton1Click)
                end
            end)
        end
    end

    local container = tradeGui:FindFirstChild("Container")
    if not container or not container.Visible then
        TradeSummaryCard.Visible = false
        return
    end

    TradeSummaryCard.Visible = true

    local yourTotal = 0
    local theirTotal = 0

    for _, itemSlot in ipairs(tradeGui:GetDescendants()) do
        if itemSlot.Name ~= "ValueBadge" and itemSlot:IsA("TextLabel") and itemSlot.Text ~= "" and itemSlot.Visible then
            local val = LookupItemValue(itemSlot.Text)
            if val and val > 0 then
                local parentBox = itemSlot.Parent
                if parentBox and parentBox:IsA("GuiObject") then
                    local badge = parentBox:FindFirstChild("ValueBadge")
                    if not badge then
                        badge = Instance.new("TextLabel")
                        badge.Name = "ValueBadge"
                        badge.Size = UDim2.fromOffset(50, 16)
                        badge.Position = UDim2.new(1, -52, 0, 2)
                        badge.BackgroundColor3 = Color3.fromRGB(15, 16, 20)
                        badge.BorderSizePixel = 0
                        badge.Font = Enum.Font.GothamBold
                        badge.TextSize = 9
                        badge.TextColor3 = Theme.Green
                        -- Active et Selectable false pour ne jamais bloquer les clics
                        badge.Active = false
                        badge.Selectable = false
                        badge.ZIndex = 2
                        badge.Parent = parentBox
                        Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 3)
                    end
                    badge.Text = tostring(val) .. " Val"

                    local fullName = parentBox:GetFullName():lower()
                    if fullName:find("your") or fullName:find("my") or fullName:find("offer1") then
                        yourTotal = yourTotal + val
                    else
                        theirTotal = theirTotal + val
                    end
                end
            end
        end
    end

    YourValLbl.Text  = "Votre Offre : " .. tostring(yourTotal) .. " Val"
    TheirValLbl.Text = "Leur Offre  : " .. tostring(theirTotal) .. " Val"

    local diff = theirTotal - yourTotal
    if diff > 10 then
        VerdictLbl.Text = "VERDICT : WIN (+" .. tostring(diff) .. ")"
        VerdictLbl.TextColor3 = Theme.Green
    elseif diff < -10 then
        VerdictLbl.Text = "VERDICT : LOSE (" .. tostring(diff) .. ")"
        VerdictLbl.TextColor3 = Theme.Red
    else
        VerdictLbl.Text = "VERDICT : ÉQUITABLE (FAIR)"
        VerdictLbl.TextColor3 = Theme.Yellow
    end
end

task.spawn(function()
    while true do
        local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local tradeGui = pGui and pGui:FindFirstChild("TradeGUI")
        if tradeGui and tradeGui.Enabled then
            pcall(UpdateTradeGUI)
            task.wait(0.6)
        else
            if TradeSummaryCard and TradeSummaryCard.Visible then
                TradeSummaryCard.Visible = false
            end
            task.wait(1.5)
        end
    end
