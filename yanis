local function CreatePlayerListGui()
    local parent = SafeParent
    local old = parent:FindFirstChild("PlayerListHub")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "PlayerListHub"
    sg.ResetOnSpawn = false
    sg.Parent = parent

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(210, 190)
    frame.Position = UDim2.new(1, -218, 0, 36)
    frame.BackgroundColor3 = Theme.BgHeader
    frame.BorderSizePixel = 0
    frame.Parent = sg
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Theme.Border
    stroke.Thickness = 1.2

    local listScale = Instance.new("UIScale", frame)
    local function UpdateListScale()
        local vp = Camera.ViewportSize
        if vp.X > 0 and vp.Y > 0 then
            local factor = math.min((vp.X * 0.36) / 210, (vp.Y * 0.6) / 190, 1)
            listScale.Scale = math.clamp(factor, 0.55, 1)
        end
    end
    UpdateListScale()
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateListScale)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -28, 0, 24)
    title.Position = UDim2.fromOffset(8, 0)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBlack
    title.Text = "JOUEURS 💕 (FLING/TP/TRADE)"
    title.TextColor3 = Theme.TextPrimary
    title.TextSize = 9
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    -- Rendre la fenêtre JOUEURS Déplaçable (Draggable) sur PC et Mobile
    do
        local dragging = false
        local dragStart = nil
        local startPos = nil

        local function startDrag(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position

                local changedConn
                local endedConn

                changedConn = UserInputService.InputChanged:Connect(function(inp)
                    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        local delta = inp.Position - dragStart
                        frame.Position = UDim2.new(
                            startPos.X.Scale,
                            startPos.X.Offset + delta.X,
                            startPos.Y.Scale,
                            startPos.Y.Offset + delta.Y
                        )
                    end
                end)

                endedConn = UserInputService.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                        if changedConn then changedConn:Disconnect() end
                        if endedConn then endedConn:Disconnect() end
                    end
                end)
            end
        end

        title.InputBegan:Connect(startDrag)
        frame.InputBegan:Connect(function(input)
            if input.Position.Y - frame.AbsolutePosition.Y <= 28 then
                startDrag(input)
            end
        end)
    end

    local closeList = Instance.new("TextButton")
    closeList.Size = UDim2.fromOffset(18, 18)
    closeList.Position = UDim2.new(1, -22, 0, 3)
    closeList.BackgroundTransparency = 1
    closeList.Font = Enum.Font.GothamBold
    closeList.Text = "—"
    closeList.TextColor3 = Theme.TextMuted
    closeList.TextSize = 11
    closeList.Parent = frame

    local scroll = Instance.new("ScrollingFrame")
    scroll.Position = UDim2.fromOffset(4, 26)
    scroll.Size = UDim2.new(1, -8, 1, -30)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 2
    scroll.ScrollBarImageColor3 = Theme.Border
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.None
    scroll.Parent = frame

    local isMin = false
    closeList.MouseButton1Click:Connect(function()
        isMin = not isMin
        scroll.Visible = not isMin
        frame.Size = isMin and UDim2.fromOffset(210, 24) or UDim2.fromOffset(210, 190)
        closeList.Text = isMin and "+" or "—"
    end)

    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
    end)

    local function refreshList()
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        for _, p in ipairs(Players:GetPlayers()) do
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundColor3 = Theme.BgCard
            row.BorderSizePixel = 0
            row.Parent = scroll
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

            local pLabel = Instance.new("TextLabel")
            pLabel.Size = UDim2.new(1, -105, 1, 0)
            pLabel.Position = UDim2.fromOffset(6, 0)
            pLabel.BackgroundTransparency = 1
            pLabel.Font = Enum.Font.GothamMedium
            pLabel.Text = (p == LocalPlayer and "★ " or "") .. p.DisplayName
            pLabel.TextColor3 = (p == LocalPlayer and Theme.Yellow) or Theme.TextPrimary
            pLabel.TextSize = 9
            pLabel.TextXAlignment = Enum.TextXAlignment.Left
            pLabel.TextTruncate = Enum.TextTruncate.AtEnd
            pLabel.Parent = row

            if p ~= LocalPlayer then
                -- Bouton Fling
                local flingBtn = Instance.new("TextButton")
                flingBtn.Position = UDim2.new(1, -100, 0, 2)
                flingBtn.Size = UDim2.fromOffset(30, 20)
                flingBtn.BackgroundColor3 = Color3.fromRGB(45, 20, 25)
                flingBtn.BorderSizePixel = 0
                flingBtn.Font = Enum.Font.GothamBold
                flingBtn.Text = "Fling"
                flingBtn.TextColor3 = Theme.Red
                flingBtn.TextSize = 8.5
                flingBtn.Parent = row
                Instance.new("UICorner", flingBtn).CornerRadius = UDim.new(0, 3)

                flingBtn.MouseButton1Click:Connect(function()
                    task.spawn(function() FlingPlayer(p) end)
                end)

                -- Bouton TP
                local tpBtn = Instance.new("TextButton")
                tpBtn.Position = UDim2.new(1, -68, 0, 2)
                tpBtn.Size = UDim2.fromOffset(26, 20)
                tpBtn.BackgroundColor3 = Theme.BgInput
                tpBtn.BorderSizePixel = 0
                tpBtn.Font = Enum.Font.GothamBold
                tpBtn.Text = "TP"
                tpBtn.TextColor3 = Theme.Accent
                tpBtn.TextSize = 8.5
                tpBtn.Parent = row
                Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 3)

                tpBtn.MouseButton1Click:Connect(function()
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        TeleportTo(p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3))
                    end
                end)

                -- Bouton Trade Direct
                local tradeBtn = Instance.new("TextButton")
                tradeBtn.Position = UDim2.new(1, -38, 0, 2)
                tradeBtn.Size = UDim2.fromOffset(34, 20)
                tradeBtn.BackgroundColor3 = Color3.fromRGB(20, 40, 30)
                tradeBtn.BorderSizePixel = 0
                tradeBtn.Font = Enum.Font.GothamBold
                tradeBtn.Text = "Trade"
                tradeBtn.TextColor3 = Theme.Green
                tradeBtn.TextSize = 8.5
                tradeBtn.Parent = row
                Instance.new("UICorner", tradeBtn).CornerRadius = UDim.new(0, 3)

                tradeBtn.MouseButton1Click:Connect(function()
                    tradeBtn.Text = "..."
                    pcall(function()
                        local tm = require(ReplicatedStorage.Modules.TradeModule)
                        tm.SendTradeRequest(p)
                    end)
                    pcall(function()
                        ReplicatedStorage.Trade.SendRequest:InvokeServer(p)
                    end)
                    task.wait(1)
                    tradeBtn.Text = "Trade"
                end)
            end
        end
    end

    refreshList()
    Players.PlayerAdded:Connect(refreshList)
    Players.PlayerRemoving:Connect(refreshList)
end

CreatePlayerListGui()

